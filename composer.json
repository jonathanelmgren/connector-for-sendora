{
	"name": "jonathanelmgren/connector-for-sendora",
	"description": "Sends WordPress email through Sendora's API.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"ext-json": "*",
		"nyholm/psr7": "^1.8",
		"psr/http-client": "^1.0",
		"psr/http-factory": "^1.1",
		"psr/http-message": "^2.0",
		"sendora/sendora-php": "^1.0"
	},
	"require-dev": {
		"brianhenryie/strauss": "^0.31",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.8",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "^6.8",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"ConnectorForSendora\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"ConnectorForSendora\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.2.0"
		},
		"platform-check": false,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"extra": {
		"strauss": {
			"target_directory": "vendor",
			"namespace_prefix": "ConnectorForSendora\\Vendor\\",
			"classmap_prefix": "Connector_For_Sendora_Vendor_",
			"constant_prefix": "CONNECTOR_FOR_SENDORA_VENDOR_",
			"packages": [
				"sendora/sendora-php",
				"nyholm/psr7",
				"psr/http-client",
				"psr/http-factory",
				"psr/http-message"
			],
			"include_modified_date": false,
			"include_author": false,
			"parallel": false
		}
	},
	"scripts": {
		"prefix-namespaces": [
			"@php bin/strauss.php",
			"@composer dump-autoload --optimize"
		],
		"post-install-cmd": ["@prefix-namespaces"],
		"post-update-cmd": ["@prefix-namespaces"]
	}
}
