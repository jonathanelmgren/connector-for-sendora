parameters:
	level: 8
	phpVersion: 80200
	paths:
		- sendora.php
		- requirements.php
		- uninstall.php
		- src
		- tests
	excludePaths:
		- tests/mu-plugins
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
	scanDirectories:
		- vendor/wp-phpunit/wp-phpunit
